# ============================================================
# 🔐 Variáveis de Ambiente — PMGFlix Bot
# ============================================================
# Copie este arquivo para ".env" e preencha com seus dados reais
# NUNCA compartilhe seu token ou suba o .env no Git!
# ============================================================

# Token do bot Discord (obrigatório)
# Pegue em: https://discord.com/developers/applications
DISCORD_TOKEN=seu_token_aqui

# Seu ID do Discord (obrigatório)
# Clique com botão direito no seu nome > Copiar ID de Usuário
OWNER_ID=seu_id_aqui

# Chave Pix para receber pagamentos
PIX_CHAVE=seuemail@exemplo.com

# IDs dos cargos que serão dados ao aprovar (opcional)
# Crie os cargos no servidor e copie os IDs
CARGO_PREMIUM_ID=
CARGO_ULTRA_ID=

# Canal de logs para registrar transações (opcional)
# Copie o ID do canal de texto desejado
CANAL_LOGS_ID=
